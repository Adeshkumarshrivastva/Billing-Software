# Copy this file to .env.local and adjust if your MongoDB isn't on the default local port.
MONGODB_URI=mongodb://127.0.0.1:27017/pmc_billing

# Signs staff login sessions. Set this to a long random string in every real
# environment — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-this-to-a-random-string

# Razorpay Dashboard API keys. Use rzp_test_* keys while testing, then replace
# with live keys for real collections. Never expose the secret to the browser.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

SMS_API_BASE_URL=https://api.bulksmsadmin.com
SMS_UNAME=your-sms-username
SMS_PASS=your-sms-password
SMS_SENDER_ID=PSTVMC

# ── Card kiosk (POS terminal) ────────────────────────────────────────────────
# manual = works with any machine, no integration: staff key the amount into the
#          terminal and settle the payment from the printed slip.
# http   = the terminal (or a bridge service beside it) reports back on its own.
KIOSK_PROVIDER=manual
KIOSK_TERMINAL_ID=COUNTER-1
# Only needed when KIOSK_PROVIDER=http. Point it at the kiosk-bridge service
# running beside the card machine (see kiosk-bridge/README.md), on its LAN
# address — not localhost, unless both run on the same PC.
KIOSK_API_BASE_URL=
KIOSK_API_KEY=
KIOSK_MERCHANT_ID=
KIOSK_TIMEOUT_MS=10000
